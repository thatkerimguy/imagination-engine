{
  "id": "social",
  "name": {
    "en": "Social and romance",
    "tr": "Sosyal ve romantik"
  },
  "blurb": {
    "en": "Affinity with each character, a calendar of days, gifts and an event that comes on schedule.",
    "tr": "Her karakterle yakınlık, günlerden bir takvim, hediyeler ve zamanı gelince olan bir olay."
  },
  "theme": "paper",
  "layout": "box",
  "project": {
    "start": "morning",
    "variables": [
      {
        "id": "day",
        "name": {
          "en": "Day",
          "tr": "Gün"
        },
        "type": "number",
        "default": 1,
        "min": 1,
        "stat": true
      },
      {
        "id": "mika",
        "name": {
          "en": "Mika",
          "tr": "Mika"
        },
        "type": "number",
        "default": 0,
        "stat": true
      },
      {
        "id": "jun",
        "name": {
          "en": "Jun",
          "tr": "Jun"
        },
        "type": "number",
        "default": 0,
        "stat": true
      },
      {
        "id": "coins",
        "name": {
          "en": "Coins",
          "tr": "Bozuk para"
        },
        "type": "number",
        "default": 4,
        "min": 0,
        "stat": true
      },
      {
        "id": "festival",
        "name": {
          "en": "Festival announced",
          "tr": "Festival duyuruldu"
        },
        "type": "bool",
        "default": false
      }
    ],
    "characters": [
      {
        "id": "mika",
        "name": {
          "en": "Mika",
          "tr": "Mika"
        },
        "color": "accent"
      },
      {
        "id": "jun",
        "name": {
          "en": "Jun",
          "tr": "Jun"
        }
      }
    ],
    "items": [
      {
        "id": "flowers",
        "name": {
          "en": "Sunflowers",
          "tr": "Ayçiçekleri"
        },
        "kind": "item",
        "price": 2,
        "description": {
          "en": "Mika’s favourite.",
          "tr": "Mika’nın en sevdiği."
        }
      },
      {
        "id": "novel",
        "name": {
          "en": "A worn novel",
          "tr": "Yıpranmış bir roman"
        },
        "kind": "item",
        "price": 2,
        "description": {
          "en": "Jun has been looking for this one.",
          "tr": "Jun bunu arıyordu."
        }
      }
    ],
    "rules": [
      {
        "id": "festival_posters",
        "name": "The festival is announced on day 3",
        "on": "changed",
        "target": "day",
        "if": "day >= 3",
        "once": true,
        "do": [
          {
            "id": "so_1",
            "type": "set",
            "var": "festival",
            "op": "set",
            "value": true
          },
          {
            "id": "so_2",
            "type": "narration",
            "text": {
              "id": "so_2",
              "en": "Posters go up overnight: the lantern festival is coming.",
              "tr": "Afişler bir gecede asılıyor: fener festivali geliyor."
            }
          }
        ]
      }
    ],
    "routines": [
      {
        "id": "next_day",
        "name": "Next day",
        "blocks": [
          {
            "id": "so_3",
            "type": "set",
            "var": "day",
            "op": "add",
            "value": 1
          }
        ]
      }
    ],
    "screens": [
      {
        "id": "title",
        "name": {
          "en": "Title screen",
          "tr": "Başlık ekranı"
        },
        "kind": "title",
        "children": [
          {
            "id": "so_s12",
            "type": "stack",
            "direction": "column",
            "gap": "medium",
            "align": "center",
            "children": [
              {
                "id": "so_s4",
                "type": "text",
                "text": {
                  "id": "so_t5",
                  "en": "Summer Lanterns",
                  "tr": "Yaz Fenerleri"
                },
                "style": "title"
              },
              {
                "id": "so_s6",
                "type": "text",
                "text": {
                  "id": "so_t7",
                  "en": "A social and romance starter",
                  "tr": "Sosyal ve romantik başlangıç"
                },
                "style": "caption"
              },
              {
                "id": "so_s8",
                "type": "button",
                "label": {
                  "id": "so_t9",
                  "en": "Start",
                  "tr": "Başla"
                },
                "actions": [
                  {
                    "type": "start"
                  }
                ]
              },
              {
                "id": "so_s10",
                "type": "button",
                "label": {
                  "id": "so_t11",
                  "en": "Continue",
                  "tr": "Devam et"
                },
                "actions": [
                  {
                    "type": "continue"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "hud",
        "name": {
          "en": "Calendar",
          "tr": "Takvim"
        },
        "kind": "hud",
        "edge": "top",
        "children": [
          {
            "id": "so_s19",
            "type": "stack",
            "direction": "row",
            "gap": "medium",
            "align": "center",
            "children": [
              {
                "id": "so_s13",
                "type": "icon",
                "icon": "clock"
              },
              {
                "id": "so_s14",
                "type": "text",
                "text": {
                  "id": "so_t15",
                  "en": "Day {day} of 3",
                  "tr": "Gün {day} / 3"
                },
                "style": "caption"
              },
              {
                "id": "so_s16",
                "type": "icon",
                "icon": "coin"
              },
              {
                "id": "so_s17",
                "type": "text",
                "text": {
                  "id": "so_t18",
                  "en": "{coins}",
                  "tr": "{coins}"
                },
                "style": "caption"
              }
            ]
          }
        ]
      }
    ],
    "chapters": [
      {
        "id": "ch1",
        "title": {
          "en": "Three summer days",
          "tr": "Üç yaz günü"
        },
        "passages": [
          {
            "id": "morning",
            "name": "Morning",
            "blocks": [
              {
                "id": "so_20",
                "type": "narration",
                "text": {
                  "id": "so_20",
                  "en": "Day {day}. The town smells of cut grass and sea salt.",
                  "tr": "{day}. gün. Kasaba biçilmiş çimen ve deniz tuzu kokuyor."
                }
              },
              {
                "id": "so_45",
                "type": "choice",
                "options": [
                  {
                    "id": "so_o24",
                    "text": {
                      "id": "so_t25",
                      "en": "Help Mika at the bakery",
                      "tr": "Fırında Mika’ya yardım et"
                    },
                    "then": [
                      {
                        "id": "so_21",
                        "type": "dialogue",
                        "speaker": "mika",
                        "text": {
                          "id": "so_21",
                          "en": "You came! Flour everywhere, sorry.",
                          "tr": "Geldin! Her yer un, kusura bakma."
                        }
                      },
                      {
                        "id": "so_22",
                        "type": "set",
                        "var": "mika",
                        "op": "add",
                        "value": 1
                      },
                      {
                        "id": "so_23",
                        "type": "jump",
                        "to": "evening"
                      }
                    ]
                  },
                  {
                    "id": "so_o29",
                    "text": {
                      "id": "so_t30",
                      "en": "Go fishing with Jun",
                      "tr": "Jun’la balığa git"
                    },
                    "then": [
                      {
                        "id": "so_26",
                        "type": "dialogue",
                        "speaker": "jun",
                        "text": {
                          "id": "so_26",
                          "en": "Quiet is fine. Quiet is good.",
                          "tr": "Sessizlik iyidir. Sessizlik güzeldir."
                        }
                      },
                      {
                        "id": "so_27",
                        "type": "set",
                        "var": "jun",
                        "op": "add",
                        "value": 1
                      },
                      {
                        "id": "so_28",
                        "type": "jump",
                        "to": "evening"
                      }
                    ]
                  },
                  {
                    "id": "so_o33",
                    "text": {
                      "id": "so_t34",
                      "en": "Browse the market",
                      "tr": "Pazarı gez"
                    },
                    "then": [
                      {
                        "id": "so_31",
                        "type": "shop",
                        "currency": "coins",
                        "stock": [
                          {
                            "item": "flowers"
                          },
                          {
                            "item": "novel"
                          }
                        ]
                      },
                      {
                        "id": "so_32",
                        "type": "jump",
                        "to": "evening"
                      }
                    ]
                  },
                  {
                    "id": "so_o38",
                    "text": {
                      "id": "so_t39",
                      "en": "Give Mika the sunflowers",
                      "tr": "Mika’ya ayçiçeklerini ver"
                    },
                    "then": [
                      {
                        "id": "so_35",
                        "type": "item",
                        "op": "take",
                        "item": "flowers"
                      },
                      {
                        "id": "so_36",
                        "type": "set",
                        "var": "mika",
                        "op": "add",
                        "value": 2
                      },
                      {
                        "id": "so_37",
                        "type": "jump",
                        "to": "evening"
                      }
                    ],
                    "visibleIf": "owned(\"flowers\") > 0"
                  },
                  {
                    "id": "so_o43",
                    "text": {
                      "id": "so_t44",
                      "en": "Give Jun the novel",
                      "tr": "Jun’a romanı ver"
                    },
                    "then": [
                      {
                        "id": "so_40",
                        "type": "item",
                        "op": "take",
                        "item": "novel"
                      },
                      {
                        "id": "so_41",
                        "type": "set",
                        "var": "jun",
                        "op": "add",
                        "value": 2
                      },
                      {
                        "id": "so_42",
                        "type": "jump",
                        "to": "evening"
                      }
                    ],
                    "visibleIf": "owned(\"novel\") > 0"
                  }
                ],
                "prompt": {
                  "id": "so_t46",
                  "en": "How do you spend the day?",
                  "tr": "Günü nasıl geçiriyorsun?"
                }
              }
            ]
          },
          {
            "id": "evening",
            "name": "Evening",
            "blocks": [
              {
                "id": "so_47",
                "type": "routine",
                "routine": "next_day"
              },
              {
                "id": "so_50",
                "type": "if",
                "branches": [
                  {
                    "id": "so_br51",
                    "when": "day > 3",
                    "then": [
                      {
                        "id": "so_48",
                        "type": "jump",
                        "to": "festival"
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "id": "so_49",
                    "type": "jump",
                    "to": "morning"
                  }
                ]
              }
            ]
          },
          {
            "id": "festival",
            "name": "Festival",
            "blocks": [
              {
                "id": "so_52",
                "type": "narration",
                "text": {
                  "id": "so_52",
                  "en": "Lanterns rise over the harbour.",
                  "tr": "Fenerler limanın üstüne yükseliyor."
                }
              },
              {
                "id": "so_61",
                "type": "if",
                "branches": [
                  {
                    "id": "so_br62",
                    "when": "mika >= 2 && mika >= jun",
                    "then": [
                      {
                        "id": "so_53",
                        "type": "dialogue",
                        "speaker": "mika",
                        "text": {
                          "id": "so_53",
                          "en": "Walk me home after?",
                          "tr": "Sonra beni eve bırakır mısın?"
                        }
                      },
                      {
                        "id": "so_54",
                        "type": "end",
                        "ending": {
                          "id": "mika",
                          "title": {
                            "id": "so_t55",
                            "en": "Flour and lanterns",
                            "tr": "Un ve fenerler"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "id": "so_br63",
                    "when": "jun >= 2",
                    "then": [
                      {
                        "id": "so_56",
                        "type": "dialogue",
                        "speaker": "jun",
                        "text": {
                          "id": "so_56",
                          "en": "Same spot tomorrow. Bring the book.",
                          "tr": "Yarın aynı yer. Kitabı getir."
                        }
                      },
                      {
                        "id": "so_57",
                        "type": "end",
                        "ending": {
                          "id": "jun",
                          "title": {
                            "id": "so_t58",
                            "en": "The quiet pier",
                            "tr": "Sessiz iskele"
                          }
                        }
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "id": "so_59",
                    "type": "end",
                    "ending": {
                      "id": "friends",
                      "title": {
                        "id": "so_t60",
                        "en": "Good friends, long summer",
                        "tr": "İyi dostlar, uzun yaz"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
