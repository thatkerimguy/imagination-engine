{
  "id": "chat",
  "name": {
    "en": "Chat story",
    "tr": "Mesajlaşma hikâyesi"
  },
  "blurb": {
    "en": "A story told in text messages, with typing delays and replies to pick. A HUD shows who you’re talking to.",
    "tr": "Mesajlarla anlatılan bir hikâye: yazıyor beklemeleri ve seçilecek yanıtlar. Göstergede kiminle konuştuğun yazar."
  },
  "theme": "static",
  "layout": "chat",
  "project": {
    "start": "thread",
    "variables": [
      {
        "id": "warmth",
        "name": {
          "en": "Warmth",
          "tr": "Yakınlık"
        },
        "type": "number",
        "default": 0
      }
    ],
    "characters": [
      {
        "id": "sam",
        "name": {
          "en": "Sam",
          "tr": "Sam"
        },
        "color": "accent"
      },
      {
        "id": "player",
        "name": {
          "en": "You",
          "tr": "Sen"
        }
      }
    ],
    "screens": [
      {
        "id": "hud",
        "name": {
          "en": "Chat header",
          "tr": "Sohbet başlığı"
        },
        "kind": "hud",
        "edge": "top",
        "children": [
          {
            "id": "ch_hud_row",
            "type": "stack",
            "direction": "row",
            "gap": "medium",
            "align": "start",
            "children": [
              {
                "id": "ch_hud_icon",
                "type": "icon",
                "icon": "message"
              },
              {
                "id": "ch_hud_names",
                "type": "stack",
                "direction": "column",
                "gap": "none",
                "align": "stretch",
                "children": [
                  {
                    "id": "ch_hud_name",
                    "type": "text",
                    "text": {
                      "id": "ch_hud_name",
                      "en": "Unknown number",
                      "tr": "Bilinmeyen numara"
                    },
                    "style": "heading"
                  },
                  {
                    "id": "ch_hud_status",
                    "type": "text",
                    "text": {
                      "id": "ch_hud_status",
                      "en": "online",
                      "tr": "çevrimiçi"
                    },
                    "style": "caption"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "chapters": [
      {
        "id": "ch1",
        "title": {
          "en": "Wrong number",
          "tr": "Yanlış numara"
        },
        "passages": [
          {
            "id": "thread",
            "name": "Thread",
            "blocks": [
              {
                "id": "ch_1",
                "type": "dialogue",
                "speaker": "sam",
                "text": {
                  "id": "ch_1",
                  "en": "hey, is this still Defne’s number?",
                  "tr": "selam, bu hâlâ Defne’nin numarası mı?"
                }
              },
              {
                "id": "ch_2",
                "type": "dialogue",
                "speaker": "sam",
                "text": {
                  "id": "ch_2",
                  "en": "sorry. it’s 2am. i know.",
                  "tr": "pardon. saat gece 2. biliyorum."
                }
              },
              {
                "id": "ch_c1",
                "type": "choice",
                "options": [
                  {
                    "id": "ch_r1",
                    "text": {
                      "id": "ch_r1",
                      "en": "No, but I’m awake too",
                      "tr": "Hayır ama ben de uyanığım"
                    },
                    "then": [
                      {
                        "id": "ch_w1",
                        "type": "set",
                        "var": "warmth",
                        "op": "add",
                        "value": 1
                      },
                      {
                        "id": "ch_3",
                        "type": "dialogue",
                        "speaker": "sam",
                        "text": {
                          "id": "ch_3",
                          "en": "oh. hi then 🙂",
                          "tr": "aa. o zaman selam 🙂"
                        }
                      }
                    ]
                  },
                  {
                    "id": "ch_r2",
                    "text": {
                      "id": "ch_r2",
                      "en": "Wrong number",
                      "tr": "Yanlış numara"
                    },
                    "then": [
                      {
                        "id": "ch_4",
                        "type": "dialogue",
                        "speaker": "sam",
                        "text": {
                          "id": "ch_4",
                          "en": "right. sorry.",
                          "tr": "tamam. pardon."
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "ch_5",
                "type": "dialogue",
                "speaker": "sam",
                "text": {
                  "id": "ch_5",
                  "en": "can i ask you something weird",
                  "tr": "tuhaf bir şey sorabilir miyim"
                }
              },
              {
                "id": "ch_c2",
                "type": "choice",
                "options": [
                  {
                    "id": "ch_r3",
                    "text": {
                      "id": "ch_r3",
                      "en": "Go on",
                      "tr": "Sor bakalım"
                    },
                    "then": [
                      {
                        "id": "ch_w2",
                        "type": "set",
                        "var": "warmth",
                        "op": "add",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "id": "ch_r4",
                    "text": {
                      "id": "ch_r4",
                      "en": "Depends how weird",
                      "tr": "Ne kadar tuhaf olduğuna bağlı"
                    },
                    "then": []
                  }
                ]
              },
              {
                "id": "ch_6",
                "type": "dialogue",
                "speaker": "sam",
                "text": {
                  "id": "ch_6",
                  "en": "if you could leave the city tonight, would you?",
                  "tr": "bu gece şehri terk edebilsen, eder miydin?"
                }
              },
              {
                "id": "ch_if",
                "type": "if",
                "branches": [
                  {
                    "id": "ch_if_warm",
                    "when": "warmth >= 2",
                    "then": [
                      {
                        "id": "ch_7",
                        "type": "dialogue",
                        "speaker": "sam",
                        "text": {
                          "id": "ch_7",
                          "en": "the 5:40 bus. i’ll be at the back. no pressure.",
                          "tr": "5.40 otobüsü. arkada olacağım. baskı yok."
                        }
                      },
                      {
                        "id": "ch_end_bus",
                        "type": "end",
                        "ending": {
                          "id": "bus",
                          "title": {
                            "id": "ch_end_bus_t",
                            "en": "The 5:40 bus",
                            "tr": "5.40 otobüsü"
                          }
                        }
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "id": "ch_8",
                    "type": "dialogue",
                    "speaker": "sam",
                    "text": {
                      "id": "ch_8",
                      "en": "never mind. goodnight, stranger.",
                      "tr": "boş ver. iyi geceler, yabancı."
                    }
                  },
                  {
                    "id": "ch_end_night",
                    "type": "end",
                    "ending": {
                      "id": "goodnight",
                      "title": {
                        "id": "ch_end_night_t",
                        "en": "Goodnight, stranger",
                        "tr": "İyi geceler, yabancı"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
