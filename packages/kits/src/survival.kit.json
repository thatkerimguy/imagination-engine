{
  "id": "survival",
  "name": {
    "en": "Survival and management",
    "tr": "Hayatta kalma ve yönetim"
  },
  "blurb": {
    "en": "Resources to balance, days that pass, and a deck of random events each night.",
    "tr": "Dengelenecek kaynaklar, geçen günler ve her gece rastgele olaylardan bir deste."
  },
  "theme": "static",
  "layout": "page",
  "project": {
    "start": "camp",
    "variables": [
      {
        "id": "day",
        "name": {
          "en": "Day",
          "tr": "Gün"
        },
        "type": "number",
        "default": 1,
        "stat": true
      },
      {
        "id": "food",
        "name": {
          "en": "Food",
          "tr": "Yiyecek"
        },
        "type": "number",
        "default": 5,
        "min": 0,
        "max": 10,
        "stat": true
      },
      {
        "id": "morale",
        "name": {
          "en": "Morale",
          "tr": "Moral"
        },
        "type": "number",
        "default": 3,
        "min": 0,
        "max": 5,
        "stat": true
      },
      {
        "id": "wood",
        "name": {
          "en": "Wood",
          "tr": "Odun"
        },
        "type": "number",
        "default": 1,
        "min": 0,
        "stat": true
      }
    ],
    "characters": [],
    "screens": [
      {
        "id": "title",
        "name": {
          "en": "Title screen",
          "tr": "Başlık ekranı"
        },
        "kind": "title",
        "children": [
          {
            "id": "sv_s9",
            "type": "stack",
            "direction": "column",
            "gap": "medium",
            "align": "center",
            "children": [
              {
                "id": "sv_s1",
                "type": "text",
                "text": {
                  "id": "sv_t2",
                  "en": "The Long Coast",
                  "tr": "Uzun Kıyı"
                },
                "style": "title"
              },
              {
                "id": "sv_s3",
                "type": "text",
                "text": {
                  "id": "sv_t4",
                  "en": "A survival and management starter",
                  "tr": "Hayatta kalma ve yönetim başlangıcı"
                },
                "style": "caption"
              },
              {
                "id": "sv_s5",
                "type": "button",
                "label": {
                  "id": "sv_t6",
                  "en": "Start",
                  "tr": "Başla"
                },
                "actions": [
                  {
                    "type": "start"
                  }
                ]
              },
              {
                "id": "sv_s7",
                "type": "button",
                "label": {
                  "id": "sv_t8",
                  "en": "Continue",
                  "tr": "Devam et"
                },
                "actions": [
                  {
                    "type": "continue"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "hud",
        "name": {
          "en": "Supplies",
          "tr": "Erzak"
        },
        "kind": "hud",
        "edge": "top",
        "children": [
          {
            "id": "sv_s19",
            "type": "stack",
            "direction": "row",
            "gap": "medium",
            "align": "center",
            "children": [
              {
                "id": "sv_s10",
                "type": "icon",
                "icon": "clock"
              },
              {
                "id": "sv_s11",
                "type": "text",
                "text": {
                  "id": "sv_t12",
                  "en": "Day {day} of 5",
                  "tr": "Gün {day} / 5"
                },
                "style": "caption"
              },
              {
                "id": "sv_s13",
                "type": "bar",
                "var": "food",
                "label": {
                  "id": "sv_t14",
                  "en": "Food",
                  "tr": "Yiyecek"
                },
                "max": 10
              },
              {
                "id": "sv_s15",
                "type": "bar",
                "var": "morale",
                "label": {
                  "id": "sv_t16",
                  "en": "Morale",
                  "tr": "Moral"
                },
                "max": 5
              },
              {
                "id": "sv_s17",
                "type": "text",
                "text": {
                  "id": "sv_t18",
                  "en": "Wood {wood}",
                  "tr": "Odun {wood}"
                },
                "style": "caption"
              }
            ]
          }
        ]
      }
    ],
    "chapters": [
      {
        "id": "ch1",
        "title": {
          "en": "Five days",
          "tr": "Beş gün"
        },
        "passages": [
          {
            "id": "camp",
            "name": "Camp",
            "blocks": [
              {
                "id": "sv_20",
                "type": "narration",
                "text": {
                  "id": "sv_20",
                  "en": "Day {day}. The radio says help is five days out. Food {food}, morale {morale}.",
                  "tr": "{day}. gün. Telsiz yardımın beş gün uzakta olduğunu söylüyor. Yiyecek {food}, moral {morale}."
                }
              },
              {
                "id": "sv_41",
                "type": "choice",
                "options": [
                  {
                    "id": "sv_o31",
                    "text": {
                      "id": "sv_t32",
                      "en": "Forage along the shore",
                      "tr": "Kıyı boyunca yiyecek ara"
                    },
                    "then": [
                      {
                        "id": "sv_26",
                        "type": "random",
                        "branches": [
                          {
                            "id": "sv_br27",
                            "weight": 2,
                            "then": [
                              {
                                "id": "sv_21",
                                "type": "narration",
                                "text": {
                                  "id": "sv_21",
                                  "en": "Mussels and samphire. A good haul.",
                                  "tr": "Midye ve deniz börülcesi. İyi bir av."
                                }
                              },
                              {
                                "id": "sv_22",
                                "type": "set",
                                "var": "food",
                                "op": "add",
                                "value": 2
                              }
                            ]
                          },
                          {
                            "id": "sv_br28",
                            "then": [
                              {
                                "id": "sv_23",
                                "type": "narration",
                                "text": {
                                  "id": "sv_23",
                                  "en": "Nothing but kelp.",
                                  "tr": "Yosundan başka bir şey yok."
                                }
                              }
                            ]
                          },
                          {
                            "id": "sv_br29",
                            "then": [
                              {
                                "id": "sv_24",
                                "type": "narration",
                                "text": {
                                  "id": "sv_24",
                                  "en": "Fresh tracks near camp. Nobody sleeps well.",
                                  "tr": "Kampın yanında taze izler. Kimse rahat uyumuyor."
                                }
                              },
                              {
                                "id": "sv_25",
                                "type": "set",
                                "var": "morale",
                                "op": "subtract",
                                "value": 1
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "id": "sv_30",
                        "type": "jump",
                        "to": "night"
                      }
                    ]
                  },
                  {
                    "id": "sv_o35",
                    "text": {
                      "id": "sv_t36",
                      "en": "Gather driftwood",
                      "tr": "Odun topla"
                    },
                    "then": [
                      {
                        "id": "sv_33",
                        "type": "set",
                        "var": "wood",
                        "op": "add",
                        "value": 2
                      },
                      {
                        "id": "sv_34",
                        "type": "jump",
                        "to": "night"
                      }
                    ]
                  },
                  {
                    "id": "sv_o39",
                    "text": {
                      "id": "sv_t40",
                      "en": "Rest and tell stories",
                      "tr": "Dinlen ve hikâye anlat"
                    },
                    "then": [
                      {
                        "id": "sv_37",
                        "type": "set",
                        "var": "morale",
                        "op": "add",
                        "value": 1
                      },
                      {
                        "id": "sv_38",
                        "type": "jump",
                        "to": "night"
                      }
                    ]
                  }
                ],
                "prompt": {
                  "id": "sv_t42",
                  "en": "What does the camp do today?",
                  "tr": "Kamp bugün ne yapıyor?"
                }
              }
            ]
          },
          {
            "id": "night",
            "name": "Night",
            "blocks": [
              {
                "id": "sv_43",
                "type": "set",
                "var": "food",
                "op": "subtract",
                "value": 1
              },
              {
                "id": "sv_57",
                "type": "random",
                "branches": [
                  {
                    "id": "sv_br58",
                    "then": [
                      {
                        "id": "sv_44",
                        "type": "narration",
                        "text": {
                          "id": "sv_44",
                          "en": "A storm rolls in.",
                          "tr": "Bir fırtına geliyor."
                        }
                      },
                      {
                        "id": "sv_49",
                        "type": "if",
                        "branches": [
                          {
                            "id": "sv_br50",
                            "when": "wood >= 1",
                            "then": [
                              {
                                "id": "sv_45",
                                "type": "set",
                                "var": "wood",
                                "op": "subtract",
                                "value": 1
                              },
                              {
                                "id": "sv_46",
                                "type": "narration",
                                "text": {
                                  "id": "sv_46",
                                  "en": "The fire holds.",
                                  "tr": "Ateş dayanıyor."
                                }
                              }
                            ]
                          }
                        ],
                        "else": [
                          {
                            "id": "sv_47",
                            "type": "set",
                            "var": "morale",
                            "op": "subtract",
                            "value": 1
                          },
                          {
                            "id": "sv_48",
                            "type": "narration",
                            "text": {
                              "id": "sv_48",
                              "en": "The fire dies. A cold, long night.",
                              "tr": "Ateş sönüyor. Soğuk, uzun bir gece."
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "sv_br59",
                    "then": [
                      {
                        "id": "sv_51",
                        "type": "narration",
                        "text": {
                          "id": "sv_51",
                          "en": "A fishing boat passes and trades.",
                          "tr": "Bir balıkçı teknesi geçip takas ediyor."
                        }
                      },
                      {
                        "id": "sv_54",
                        "type": "if",
                        "branches": [
                          {
                            "id": "sv_br55",
                            "when": "wood >= 2",
                            "then": [
                              {
                                "id": "sv_52",
                                "type": "set",
                                "var": "wood",
                                "op": "subtract",
                                "value": 2
                              },
                              {
                                "id": "sv_53",
                                "type": "set",
                                "var": "food",
                                "op": "add",
                                "value": 2
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "sv_br60",
                    "weight": 2,
                    "then": [
                      {
                        "id": "sv_56",
                        "type": "narration",
                        "text": {
                          "id": "sv_56",
                          "en": "A quiet night. Stars over the water.",
                          "tr": "Sakin bir gece. Suyun üstünde yıldızlar."
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "sv_61",
                "type": "set",
                "var": "day",
                "op": "add",
                "value": 1
              },
              {
                "id": "sv_70",
                "type": "if",
                "branches": [
                  {
                    "id": "sv_br71",
                    "when": "food <= 0",
                    "then": [
                      {
                        "id": "sv_62",
                        "type": "end",
                        "ending": {
                          "id": "starved",
                          "title": {
                            "id": "sv_t63",
                            "en": "Empty larder",
                            "tr": "Boş kiler"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "id": "sv_br72",
                    "when": "morale <= 0",
                    "then": [
                      {
                        "id": "sv_64",
                        "type": "end",
                        "ending": {
                          "id": "gave_up",
                          "title": {
                            "id": "sv_t65",
                            "en": "The camp scatters",
                            "tr": "Kamp dağılıyor"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "id": "sv_br73",
                    "when": "day > 5",
                    "then": [
                      {
                        "id": "sv_66",
                        "type": "narration",
                        "text": {
                          "id": "sv_66",
                          "en": "An engine on the horizon.",
                          "tr": "Ufukta bir motor sesi."
                        }
                      },
                      {
                        "id": "sv_67",
                        "type": "end",
                        "ending": {
                          "id": "rescued",
                          "title": {
                            "id": "sv_t68",
                            "en": "Rescued",
                            "tr": "Kurtarıldınız"
                          }
                        }
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "id": "sv_69",
                    "type": "jump",
                    "to": "camp"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
