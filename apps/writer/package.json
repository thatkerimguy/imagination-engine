{
  "name": "@kn/writer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ../../scripts/build-preview-bundle.mjs --if-stale && expo start",
    "web": "node ../../scripts/build-preview-bundle.mjs --if-stale && expo start --web",
    "export:web": "node ../../scripts/build-preview-bundle.mjs --if-stale && expo export --platform web --output-dir dist",
    "export:android": "node ../../scripts/build-preview-bundle.mjs --if-stale && expo export --platform android --output-dir dist-android",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/crimson-pro": "^0.4.2",
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/merriweather": "^0.4.2",
    "@expo-google-fonts/source-sans-3": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@kn/core": "workspace:*",
    "@kn/module-bl-dice-3d": "workspace:*",
    "@kn/module-core-ambient-bed": "workspace:*",
    "@kn/module-gits-cyberbrain-chat": "workspace:*",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0"
  }
}
