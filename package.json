{
  "name": "kinetic-novel-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @kn/reader dev",
    "build": "pnpm --filter @kn/reader build && node scripts/bundle-report.mjs",
    "preview": "pnpm --filter @kn/reader preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/writer/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "writer": "pnpm --filter @kn/writer start",
    "writer:web": "pnpm --filter @kn/writer web",
    "writer:export": "pnpm --filter @kn/writer export:web",
    "writer:shots": "node scripts/writer-shots.mjs",
    "build:preview-bundle": "node scripts/build-preview-bundle.mjs",
    "android:prebuild": "node scripts/build-preview-bundle.mjs --if-stale && pnpm --filter @kn/writer exec expo prebuild --platform android --clean",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
