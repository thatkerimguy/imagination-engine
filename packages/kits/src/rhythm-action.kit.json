              },
              {
                "id": "ra_25",
                "type": "choice",
                "options": [
                  {
                    "id": "ra_o19",
                    "text": {
                      "id": "ra_t20",
                      "en": "Step onto the floor",
                      "tr": "Piste çık"
                    },
                    "then": [
                      {
                        "id": "ra_18",
                        "type": "jump",
                        "to": "battle"
                      }
                    ]
                  },
                  {
                    "id": "ra_o23",
                    "text": {
                      "id": "ra_t24",
                      "en": "Watch from the bar",
                      "tr": "Bardan izle"
