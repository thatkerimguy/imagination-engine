{
  "expo": {
    "name": "Kinetic Writer",
    "slug": "kinetic-writer",
    "scheme": "kinetic-writer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16171a",
    "ios": { "supportsTablet": false, "bundleIdentifier": "dev.kinetic.writer" },
    "android": { "package": "dev.kinetic.writer" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": { "typedRoutes": false }
  }
}
