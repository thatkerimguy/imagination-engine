{
  "id": "terminal",
  "name": {
    "en": "Terminal",
    "tr": "Terminal"
  },
  "blurb": {
    "en": "A terminal look, choices written as commands, and a hacking minigame with a trace that climbs.",
    "tr": "Terminal görünümü, komut gibi yazılmış seçenekler ve izi yükselen bir hackleme mini oyunu."
  },
  "theme": "terminal",
  "layout": "page",
  "project": {
    "start": "shell",
    "variables": [
      {
        "id": "trace",
        "name": {
          "en": "Trace",
          "tr": "İz"
        },
        "type": "number",
        "default": 0,
        "min": 0,
        "max": 3,
        "stat": true
      }
    ],
    "characters": [],
    "screens": [
      {
        "id": "title",
        "name": {
          "en": "Title screen",
          "tr": "Başlık ekranı"
        },
        "kind": "title",
        "children": [
          {
            "id": "tm_s9",
            "type": "stack",
            "direction": "column",
            "gap": "medium",
            "align": "center",
            "children": [
              {
                "id": "tm_s1",
                "type": "text",
                "text": {
                  "id": "tm_t2",
                  "en": "NODE-7",
                  "tr": "NODE-7"
                },
                "style": "title"
              },
              {
                "id": "tm_s3",
                "type": "text",
                "text": {
                  "id": "tm_t4",
                  "en": "A terminal starter",
                  "tr": "Terminal başlangıcı"
                },
                "style": "caption"
              },
              {
                "id": "tm_s5",
                "type": "button",
                "label": {
                  "id": "tm_t6",
                  "en": "Start",
                  "tr": "Başla"
                },
                "actions": [
                  {
                    "type": "start"
                  }
                ]
              },
              {
                "id": "tm_s7",
                "type": "button",
                "label": {
                  "id": "tm_t8",
                  "en": "Continue",
                  "tr": "Devam et"
                },
                "actions": [
                  {
                    "type": "continue"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "hud",
        "name": {
          "en": "Trace",
          "tr": "İz"
        },
        "kind": "hud",
        "edge": "top",
        "children": [
          {
            "id": "tm_s13",
            "type": "stack",
            "direction": "row",
            "gap": "medium",
            "align": "center",
            "children": [
              {
                "id": "tm_s10",
                "type": "icon",
                "icon": "bolt"
              },
              {
                "id": "tm_s11",
                "type": "text",
                "text": {
                  "id": "tm_t12",
                  "en": "trace {trace}/2",
                  "tr": "iz {trace}/2"
                },
                "style": "caption"
              }
            ]
          }
        ]
      }
    ],
    "chapters": [
      {
        "id": "ch1",
        "title": {
          "en": "Session",
          "tr": "Oturum"
        },
        "passages": [
          {
            "id": "shell",
            "name": "Shell",
            "blocks": [
              {
                "id": "tm_14",
                "type": "narration",
                "text": {
                  "id": "tm_14",
                  "en": "NODE-7 ready. Last login: never.",
                  "tr": "NODE-7 hazır. Son giriş: hiç."
                }
              },
              {
                "id": "tm_30",
                "type": "choice",
                "options": [
                  {
                    "id": "tm_o17",
                    "text": {
                      "id": "tm_t18",
                      "en": "> ls",
                      "tr": "> ls"
                    },
                    "then": [
                      {
                        "id": "tm_15",
                        "type": "narration",
                        "text": {
                          "id": "tm_15",
                          "en": "notes.txt   vault/   .history",
                          "tr": "notlar.txt   kasa/   .gecmis"
                        }
                      },
                      {
                        "id": "tm_16",
                        "type": "jump",
                        "to": "shell"
                      }
                    ]
                  },
                  {
                    "id": "tm_o21",
                    "text": {
                      "id": "tm_t22",
                      "en": "> cat notes.txt",
                      "tr": "> cat notlar.txt"
                    },
                    "then": [
                      {
                        "id": "tm_19",
                        "type": "narration",
                        "text": {
                          "id": "tm_19",
                          "en": "“Vault password is the cat’s name, scrambled. Don’t forget again. —R”",
                          "tr": "“Kasa şifresi kedinin adı, karıştırılmış. Yine unutma. —R”"
                        }
                      },
                      {
                        "id": "tm_20",
                        "type": "jump",
                        "to": "shell"
                      }
                    ]
                  },
                  {
                    "id": "tm_o24",
                    "text": {
                      "id": "tm_t25",
                      "en": "> ssh vault",
                      "tr": "> ssh kasa"
                    },
                    "then": [
                      {
                        "id": "tm_23",
                        "type": "jump",
                        "to": "vault"
                      }
                    ]
                  },
                  {
                    "id": "tm_o28",
                    "text": {
                      "id": "tm_t29",
                      "en": "> logout",
                      "tr": "> çıkış"
                    },
                    "then": [
                      {
                        "id": "tm_26",
                        "type": "end",
                        "ending": {
                          "id": "logout",
                          "title": {
                            "id": "tm_t27",
                            "en": "Connection closed",
                            "tr": "Bağlantı kapandı"
                          }
                        }
                      }
                    ]
                  }
                ],
                "prompt": {
                  "id": "tm_t31",
                  "en": "$ _",
                  "tr": "$ _"
                }
              }
            ]
          },
          {
            "id": "vault",
            "name": "Vault",
            "blocks": [
              {
                "id": "tm_32",
                "type": "minigame",
                "title": {
                  "en": "Unscramble the password",
                  "tr": "Şifreyi çöz"
                },
                "game": {
                  "template": "cipher",
                  "words": [
                    {
                      "en": "MITTENS",
                      "tr": "PAMUK"
                    }
                  ]
                },
                "win": [
                  {
                    "id": "tm_33",
                    "type": "narration",
                    "text": {
                      "id": "tm_33",
                      "en": "ACCESS GRANTED. Welcome, root.",
                      "tr": "ERİŞİM VERİLDİ. Hoş geldin, root."
                    }
                  },
                  {
                    "id": "tm_34",
                    "type": "end",
                    "ending": {
                      "id": "root",
                      "title": {
                        "id": "tm_t35",
                        "en": "root@vault",
                        "tr": "root@kasa"
                      }
                    }
                  }
                ],
                "lose": [
                  {
                    "id": "tm_36",
                    "type": "set",
                    "var": "trace",
                    "op": "add",
                    "value": 1
                  },
                  {
                    "id": "tm_42",
                    "type": "if",
                    "branches": [
                      {
                        "id": "tm_br43",
                        "when": "trace >= 2",
                        "then": [
                          {
                            "id": "tm_37",
                            "type": "narration",
                            "text": {
                              "id": "tm_37",
                              "en": "TRACE COMPLETE.",
                              "tr": "İZ TAMAMLANDI."
                            }
                          },
                          {
                            "id": "tm_38",
                            "type": "end",
                            "ending": {
                              "id": "traced",
                              "title": {
                                "id": "tm_t39",
                                "en": "They know where you are",
                                "tr": "Nerede olduğunu biliyorlar"
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "else": [
                      {
                        "id": "tm_40",
                        "type": "narration",
                        "text": {
                          "id": "tm_40",
                          "en": "ACCESS DENIED. Trace {trace}/2.",
                          "tr": "ERİŞİM REDDEDİLDİ. İz {trace}/2."
                        }
                      },
                      {
                        "id": "tm_41",
                        "type": "jump",
                        "to": "shell"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
