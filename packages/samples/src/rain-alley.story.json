{
  "format": "imagination.story",
  "schemaVersion": 1,
  "id": "rain_alley",
  "title": {
    "en": "The Rain Alley",
    "tr": "Yağmurlu Sokak"
  },
  "author": "Imagination Engine sample",
  "languages": ["en", "tr"],
  "start": "prologue",
  "layout": "page",
  "variables": [
    {
      "id": "name",
      "name": {
        "en": "Name",
        "tr": "İsim"
      },
      "type": "text",
      "default": "Can"
    },
    {
      "id": "pronoun",
      "name": {
        "en": "Pronoun",
        "tr": "Zamir"
      },
      "type": "enum",
      "values": ["they", "she", "he"]
    },
    {
      "id": "gold",
      "name": {
        "en": "Gold",
        "tr": "Altın"
      },
      "type": "number",
      "default": 8,
      "min": 0
    },
    {
      "id": "charisma",
      "name": {
        "en": "Charisma",
        "tr": "Karizma"
      },
      "type": "number",
      "default": 4
    },
    {
      "id": "agility",
      "name": {
        "en": "Agility",
        "tr": "Çeviklik"
      },
      "type": "number",
      "default": 3
    },
    {
      "id": "trust",
      "name": {
        "en": "Mira's trust",
        "tr": "Mira'nın güveni"
      },
      "type": "number"
    },
    {
      "id": "has_lamp",
      "name": {
        "en": "Has the lamp",
        "tr": "Lamba var"
      },
      "type": "bool"
    },
    {
      "id": "bag",
      "name": {
        "en": "Bag",
        "tr": "Çanta"
      },
      "type": "list"
    },
    {
      "id": "runs",
      "name": {
        "en": "Walks down the alley",
        "tr": "Sokaktan geçişler"
      },
      "type": "number",
      "scope": "persistent",
      "description": "Counts playthroughs, so the story can remember earlier ones."
    },
    {
      "id": "duel",
      "name": {
        "en": "Duel score",
        "tr": "Düello puanı"
      },
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 100
    }
  ],
  "characters": [
    {
      "id": "mira",
      "name": {
        "en": "Mira",
        "tr": "Mira"
      },
      "color": "accent"
    },
    {
      "id": "stranger",
      "name": {
        "en": "Stranger",
        "tr": "Yabancı"
      }
    },
    {
      "id": "player",
      "name": {
        "en": "You",
        "tr": "Sen"
      }
    }
  ],
  "chapters": [
    {
      "id": "alley_chapter",
      "title": {
        "en": "The Alley",
        "tr": "Sokak"
      },
      "passages": [
        {
          "id": "prologue",
          "name": "Prologue",
          "blocks": [
            {
              "id": "pro_stage_rain",
              "type": "action",
              "action": "stage.background.set",
              "params": {
                "preset": "rain",
                "amount": 0.6
              }
            },
            {
              "id": "pro_rain",
              "type": "narration",
              "text": {
                "id": "pro_rain",
                "en": "[fade]Rain. The kind that gets into your bones.[/fade]",
                "tr": "[fade]Yağmur. İliklerine işleyen cinsten.[/fade]"
              }
            },
            {
              "id": "pro_count",
              "type": "set",
              "var": "runs",
              "op": "add",
              "value": 1
            },
            {
              "id": "pro_again",
              "type": "if",
              "branches": [
                {
                  "id": "pro_again_yes",
                  "when": "runs > 1",
                  "then": [
                    {
                      "id": "pro_familiar",
                      "type": "narration",
                      "text": {
                        "id": "pro_familiar",
                        "en": "[i]This alley feels familiar.[pause=300] You have been here before.[/i]",
                        "tr": "[i]Bu sokak tanıdık geliyor.[pause=300] Buraya daha önce gelmiştin.[/i]"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "pro_soaked",
              "type": "dialogue",
              "speaker": "mira",
              "text": {
                "id": "pro_soaked",
                "en": "You're soaked. What do they call you?",
                "tr": "Sırılsıklamsın. Sana ne diyorlar?"
              }
            },
            {
              "id": "pro_name",
              "type": "input",
              "var": "name",
              "maxLength": 20,
              "prompt": {
                "id": "pro_name_prompt",
                "en": "Your name",
                "tr": "Adın"
              }
            },
            {
              "id": "pro_close",
              "type": "dialogue",
              "speaker": "mira",
              "text": {
                "id": "pro_close",
                "en": "{name}. Good. Stay close, {name}.",
                "tr": "{name}. Güzel. Yakınımda dur, {name}."
              }
            },
            {
              "id": "pro_pronoun",
              "type": "choice",
              "prompt": {
                "id": "pro_pronoun_prompt",
                "en": "How should Mira speak of you?",
                "tr": "Mira senden nasıl bahsetsin?"
              },
              "options": [
                {
                  "id": "pro_she",
                  "text": {
                    "id": "pro_she",
                    "en": "She",
                    "tr": "Kadın olarak"
                  },
                  "then": [
                    {
                      "id": "pro_set_she",
                      "type": "set",
                      "var": "pronoun",
                      "value": "'she'"
                    }
                  ]
                },
                {
                  "id": "pro_he",
                  "text": {
                    "id": "pro_he",
                    "en": "He",
                    "tr": "Erkek olarak"
                  },
                  "then": [
                    {
                      "id": "pro_set_he",
                      "type": "set",
                      "var": "pronoun",
                      "value": "'he'"
                    }
                  ]
                },
                {
                  "id": "pro_they",
                  "text": {
                    "id": "pro_they",
                    "en": "They",
                    "tr": "Fark etmez"
                  },
                  "then": [
                    {
                      "id": "pro_set_they",
                      "type": "set",
                      "var": "pronoun",
                      "value": "'they'"
                    }
                  ]
                }
              ]
            },
            {
              "id": "pro_with_me",
              "type": "dialogue",
              "speaker": "mira",
              "text": {
                "id": "pro_with_me",
                "en": "If anyone asks, {pronoun, select, she {she's} he {he's} other {they're}} with me.",
                "tr": "Soran olursa, o benimle."
              }
            },
            {
              "id": "pro_winter",
              "type": "choice",
              "prompt": {
                "id": "pro_winter_prompt",
                "en": "What got you through last winter?",
                "tr": "Geçen kışı ne sayesinde atlattın?"
              },
              "options": [
                {
                  "id": "pro_tongue",
                  "text": {
                    "id": "pro_tongue",
                    "en": "A quick tongue",
                    "tr": "Hazırcevaplığım"
                  },
                  "then": [
                    {
                      "id": "pro_cha",
                      "type": "set",
                      "var": "charisma",
                      "op": "add",
                      "value": 2
                    }
                  ]
                },
                {
                  "id": "pro_feet",
                  "text": {
                    "id": "pro_feet",
                    "en": "Quick feet",
                    "tr": "Çevik ayaklarım"
                  },
                  "then": [
                    {
                      "id": "pro_agi",
                      "type": "set",
                      "var": "agility",
                      "op": "add",
                      "value": 3
                    }
                  ]
                },
                {
                  "id": "pro_luck",
                  "text": {
                    "id": "pro_luck",
                    "en": "Plain luck",
                    "tr": "Düpedüz şans"
                  },
                  "then": [
                    {
                      "id": "pro_gold",
                      "type": "set",
                      "var": "gold",
                      "op": "add",
                      "value": 2
                    }
                  ]
                }
              ]
            },
            {
              "id": "pro_go",
              "type": "jump",
              "to": "alley"
            }
          ]
        },
        {
          "id": "alley",
          "name": "The alley",
          "blocks": [
            {
              "id": "al_narrow",
              "type": "narration",
              "text": {
                "id": "al_narrow",
                "en": "The alley narrows. Water [wave]drips[/wave] from every gutter.",
                "tr": "Sokak daralıyor. Her oluktan su [wave]damlıyor[/wave]."
              }
            },
            {
              "id": "al_figure",
              "type": "narration",
              "text": {
                "id": "al_figure",
                "en": "A figure blocks the far end. Hood up. Very still.",
                "tr": "Uzak uçta bir siluet yolu kesiyor. Başlıklı. Kıpırtısız."
              }
            },
            {
              "id": "al_turn",
              "type": "dialogue",
              "speaker": "stranger",
              "text": {
                "id": "al_turn",
                "en": "[whisper]Turn around.[/whisper]",
                "tr": "[whisper]Geri dön.[/whisper]"
              }
            },
            {
              "id": "al_call",
              "type": "dialogue",
              "speaker": "mira",
              "text": {
                "id": "al_call",
                "en": "[tremble]Your call, {name}.[/tremble] Whatever you do, do it now.",
                "tr": "[tremble]Karar {name}'in.[/tremble] Ne yapacaksan şimdi yap."
              }
            },
            {
              "id": "al_go",
              "type": "jump",
              "to": "crossroads"
            }
          ]
        },
        {
          "id": "crossroads",
          "name": "What now?",
          "keepPage": true,
          "blocks": [
            {
              "id": "cross",
              "type": "choice",
              "options": [
                {
                  "id": "o_blade",
                  "text": {
                    "id": "o_blade",
                    "en": "Draw your blade",
                    "tr": "Kılıcını çek"
                  },
                  "then": [
                    {
                      "id": "o_blade_go",
                      "type": "jump",
                      "to": "fight"
                    }
                  ]
                },
                {
                  "id": "o_talk",
                  "text": {
                    "id": "o_talk",
                    "en": "Talk them down",
                    "tr": "Konuşarak ikna et"
                  },
                  "enabledIf": "charisma >= 6",
                  "then": [
                    {
                      "id": "o_talk_go",
                      "type": "jump",
                      "to": "parley"
                    }
                  ]
                },
                {
                  "id": "o_bribe",
                  "text": {
                    "id": "o_bribe",
                    "en": "Offer coins",
                    "tr": "Para teklif et"
                  },
                  "cost": {
                    "var": "gold",
                    "amount": 10
                  },
                  "then": [
                    {
                      "id": "o_bribe_go",
                      "type": "jump",
                      "to": "bribe"
                    }
                  ]
                },
                {
                  "id": "o_run",
                  "text": {
                    "id": "o_run",
                    "en": "Run for the gap",
                    "tr": "Boşluğa doğru koş"
                  },
                  "showOdds": true,
                  "then": [
                    {
                      "id": "o_run_check",
                      "type": "check",
                      "label": {
                        "id": "o_run_label",
                        "en": "Agility",
                        "tr": "Çeviklik"
                      },
                      "dice": "1d20",
                      "modifier": "agility",
                      "target": 12,
                      "success": [
                        {
                          "id": "o_run_ok",
                          "type": "narration",
                          "text": {
                            "id": "o_run_ok",
                            "en": "You slip past, close enough to smell the wet wool.",
                            "tr": "Islak yünün kokusunu alacak kadar yakından sıyrılıp geçiyorsun."
                          }
                        },
                        {
                          "id": "o_run_ok_go",
                          "type": "jump",
                          "to": "escaped"
                        }
                      ],
                      "fail": [
                        {
                          "id": "o_run_fail",
                          "type": "narration",
                          "text": {
                            "id": "o_run_fail",
                            "en": "Your foot catches on a loose stone.",
                            "tr": "Ayağın gevşek bir taşa takılıyor."
                          }
                        },
                        {
                          "id": "o_run_fail_go",
                          "type": "jump",
                          "to": "fight"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "o_search",
                  "text": {
                    "id": "o_search",
                    "en": "Search the crates first",
                    "tr": "Önce sandıkları ara"
                  },
                  "once": true,
                  "then": [
                    {
                      "id": "o_search_call",
                      "type": "call",
                      "to": "crates"
                    },
                    {
                      "id": "o_search_back",
                      "type": "jump",
                      "to": "crossroads"
                    }
                  ]
                },
                {
                  "id": "o_lamp",
                  "text": {
                    "id": "o_lamp",
                    "en": "Raise the lamp",
                    "tr": "Lambayı kaldır"
                  },
                  "visibleIf": "has_lamp",
                  "then": [
                    {
                      "id": "o_lamp_go",
                      "type": "jump",
                      "to": "lamp"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "crates",
          "name": "Crates (called)",
          "keepPage": true,
          "blocks": [
            {
              "id": "cr_crouch",
              "type": "narration",
              "text": {
                "id": "cr_crouch",
                "en": "You crouch by the crates. Wet wood, rusted nails.",
                "tr": "Sandıkların yanına çömeliyorsun. Islak tahta, paslı çiviler."
              }
            },
            {
              "id": "cr_find",
              "type": "random",
              "branches": [
                {
                  "id": "cr_lamp",
                  "weight": 2,
                  "then": [
                    {
                      "id": "cr_lamp_set",
                      "type": "set",
                      "var": "has_lamp",
                      "value": true
                    },
                    {
                      "id": "cr_lamp_bag",
                      "type": "set",
                      "var": "bag",
                      "op": "append",
                      "value": "'lamp'"
                    },
                    {
                      "id": "cr_lamp_line",
                      "type": "narration",
                      "text": {
                        "id": "cr_lamp_line",
                        "en": "An old oil lamp, still half full.",
                        "tr": "Eski bir gaz lambası, yarısı hâlâ dolu."
                      }
                    }
                  ]
                },
                {
                  "id": "cr_coins",
                  "weight": 1,
                  "then": [
                    {
                      "id": "cr_coins_set",
                      "type": "set",
                      "var": "gold",
                      "op": "add",
                      "value": 5
                    },
                    {
                      "id": "cr_coins_line",
                      "type": "narration",
                      "text": {
                        "id": "cr_coins_line",
                        "en": "A few coins. You now carry {gold} gold.",
                        "tr": "Birkaç sikke. Kesende artık {gold} altın var."
                      }
                    }
                  ]
                },
                {
                  "id": "cr_none",
                  "weight": 1,
                  "then": [
                    {
                      "id": "cr_none_line",
                      "type": "narration",
                      "text": {
                        "id": "cr_none_line",
                        "en": "Nothing but rats.",
                        "tr": "Farelerden başka bir şey yok."
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "parley",
          "name": "Parley",
          "layout": "box",
          "blocks": [
            {
              "id": "pa_1",
              "type": "dialogue",
              "speaker": "player",
              "text": {
                "id": "pa_1",
                "en": "We don't want trouble.",
                "tr": "Bela istemiyoruz."
              }
            },
            {
              "id": "pa_2",
              "type": "dialogue",
              "speaker": "stranger",
              "text": {
                "id": "pa_2",
                "en": "Nobody does.[pause=500] And yet.",
                "tr": "Kimse istemez.[pause=500] Yine de."
              }
            },
            {
              "id": "pa_trust",
              "type": "set",
              "var": "trust",
              "op": "add",
              "value": 2
            },
            {
              "id": "pa_3",
              "type": "dialogue",
              "speaker": "mira",
              "text": {
                "id": "pa_3",
                "en": "Let {pronoun, select, she {her} he {him} other {them}} through. Please.",
                "tr": "Bırak geçsin. Lütfen."
              }
            },
            {
              "id": "pa_4",
              "type": "narration",
              "text": {
                "id": "pa_4",
                "en": "The figure steps aside, slowly, like a door that has made up its mind.",
                "tr": "Siluet yavaşça kenara çekiliyor, kararını vermiş bir kapı gibi."
              }
            },
            {
              "id": "pa_end",
              "type": "end",
              "ending": {
                "id": "words",
                "title": {
                  "id": "end_words",
                  "en": "Words, not steel",
                  "tr": "Çelik değil, söz"
                }
              }
            }
          ]
        },
        {
          "id": "bribe",
          "name": "Bribe",
          "blocks": [
            {
              "id": "br_1",
              "type": "narration",
              "text": {
                "id": "br_1",
                "en": "You hold out ten coins. They vanish into a gloved hand.",
                "tr": "On sikke uzatıyorsun. Eldivenli bir elde kayboluyorlar."
              }
            },
            {
              "id": "br_2",
              "type": "narration",
              "text": {
                "id": "br_2",
                "en": "{gold, plural, =0 {Your purse is empty now.} one {One coin left.} other {# coins left.}}",
                "tr": "{gold, plural, =0 {Kesen artık boş.} other {Geriye # sikke kaldı.}}"
              }
            },
            {
              "id": "br_go",
              "type": "jump",
              "to": "escaped"
            }
          ]
        },
        {
          "id": "fight",
          "name": "Fight",
          "blocks": [
            {
              "id": "fi_shake",
              "type": "action",
              "action": "stage.shake",
              "params": {
                "strength": 0.6
              }
            },
            {
              "id": "fi_flash",
              "type": "action",
              "action": "stage.flash",
              "params": {
                "color": "white"
              }
            },
            {
              "id": "fi_1",
              "type": "narration",
              "text": {
                "id": "fi_1",
                "en": "[shake]Steel rings against steel.[/shake]",
                "tr": "[shake]Çelik çeliğe çarpıyor.[/shake]"
              }
            },
            {
              "id": "fi_choice",
              "type": "choice",
              "prompt": {
                "id": "fi_prompt",
                "en": "The blade comes down!",
                "tr": "Kılıç iniyor!"
              },
              "timer": {
                "seconds": 8,
                "default": "f_freeze"
              },
              "options": [
                {
                  "id": "f_parry",
                  "text": {
                    "id": "f_parry",
                    "en": "Parry",
                    "tr": "Savuştur"
                  },
                  "showOdds": true,
                  "then": [
                    {
                      "id": "f_parry_check",
                      "type": "check",
                      "label": {
                        "id": "f_parry_label",
                        "en": "Agility",
                        "tr": "Çeviklik"
                      },
                      "dice": "2d6",
                      "modifier": "agility",
                      "target": 11,
                      "success": [
                        {
                          "id": "f_parry_sparks",
                          "type": "action",
                          "action": "stage.burst",
                          "params": {
                            "preset": "sparks",
                            "color": "gold"
                          }
                        },
                        {
                          "id": "f_parry_stop",
                          "type": "action",
                          "action": "stage.hitstop",
                          "params": {
                            "seconds": 0.08
                          }
                        },
                        {
                          "id": "f_parry_ok",
                          "type": "narration",
                          "text": {
                            "id": "f_parry_ok",
                            "en": "Sparks. The blade glances off and the stranger stumbles back.",
                            "tr": "Kıvılcımlar. Kılıç sekiyor, yabancı geriye sendeliyor."
                          }
                        },
                        {
                          "id": "f_win",
                          "type": "end",
                          "ending": {
                            "id": "victory",
                            "title": {
                              "id": "end_victory",
                              "en": "Steel and sparks",
                              "tr": "Çelik ve kıvılcım"
                            }
                          }
                        }
                      ],
                      "fail": [
                        {
                          "id": "f_parry_fail",
                          "type": "narration",
                          "text": {
                            "id": "f_parry_fail",
                            "en": "Too slow. Pain, bright and sudden.",
                            "tr": "Çok yavaş. Keskin, ani bir acı."
                          }
                        },
                        {
                          "id": "f_scar",
                          "type": "end",
                          "ending": {
                            "id": "scar",
                            "title": {
                              "id": "end_scar",
                              "en": "A scar to remember",
                              "tr": "Unutulmayacak bir iz"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "f_dodge",
                  "text": {
                    "id": "f_dodge",
                    "en": "Dodge left",
                    "tr": "Sola kaç"
                  },
                  "then": [
                    {
                      "id": "f_dodge_line",
                      "type": "narration",
                      "text": {
                        "id": "f_dodge_line",
                        "en": "You roll through a puddle and come up running.",
                        "tr": "Bir su birikintisinin içinden yuvarlanıp koşarak kalkıyorsun."
                      }
                    },
                    {
                      "id": "f_dodge_go",
                      "type": "jump",
                      "to": "escaped"
                    }
                  ]
                },
                {
                  "id": "f_duel",
                  "text": {
                    "id": "f_duel",
                    "en": "Meet them blow for blow",
                    "tr": "Darbeye darbeyle karşılık ver"
                  },
                  "then": [
                    {
                      "id": "f_duel_line",
                      "type": "narration",
                      "text": {
                        "id": "f_duel_line",
                        "en": "You find the rhythm of the rain, and the stranger's.",
                        "tr": "Yağmurun ritmini buluyorsun, yabancınınkini de."
                      }
                    },
                    {
                      "id": "f_duel_fight",
                      "type": "fight",
                      "enemy": "stranger_foe",
                      "mode": "call",
                      "difficulty": "easy",
                      "bars": 12,
                      "score": "duel",
