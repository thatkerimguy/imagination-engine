{
  "expo": {
    "name": "Kinetic Writer",
    "slug": "kinetic-writer",
    "scheme": "kinetic-writer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#16171a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.kinetic.writer",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kinetic Writer uses Face ID to unlock your private manuscripts."
      }
    },
    "android": {
      "package": "dev.kinetic.writer",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.VIBRATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "./plugins/with-android-polish",
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kinetic Writer uses Face ID to unlock your private manuscripts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kinetic Writer opens your photos so you can add images to a chapter.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
